<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lembretes</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="home">
  <main>
    <%# O sinal de igual imprime um valor; sem ele, o bloco executa JavaScript. %>
    <h1><%= tituloPagina %></h1>
    <img class="sino" src="/img/sino.svg" alt="Sino de lembrete com relógio" width="200" height="200">
    <h1>O que você gostaria de lembrar?</h1>
    <ul class="categorias">
      <% categorias.forEach(function(categoria) { %>
        <li><%= categoria %></li>
      <% }); %>
    </ul>

    <!-- Para salvar usando GET, troque method="post" por method="get". -->
    <form action="/salvar" method="post">
      <p><label for="titulo">Título:</label> <input id="titulo" name="titulo" type="text" maxlength="120" required></p>
      <p><label for="descricao">Descrição:</label> <input id="descricao" name="descricao" type="text" maxlength="1000" required></p>
      <p><label for="local">Local:</label> <input id="local" name="local" type="text" maxlength="200" required></p>
      <p><label for="data">Data:</label> <input id="data" name="data" type="date" min="0001-01-01" max="9999-12-31" required></p>
      <p><label for="hora">Hora:</label> <input id="hora" name="hora" type="time" required></p>
      <p><button type="submit">Salvar</button></p>
      <!-- formnovalidate permite listar sem preencher os campos. -->
      <p><button type="submit" formaction="/listar" formmethod="get" formnovalidate>Listar</button></p>
    </form>
  </main>
</body>
</html>
